  region: 0
  rewardMessage: FAGULHA DE FOGO RECEBIDA
  rewardIllustration: {fileID: 21300000, guid: 66bc106943c0a3349b52c32acdf10bba, type: 3}
  memoryPages:
  - speakerName: LUMI
    dialogue: "A Fagulha carrega mais do que poder, Lyren. Ela tamb\xE9m guarda uma
      mem\xF3ria."
    illustration: {fileID: 21300000, guid: 65acd7f5862d7e34088c06bb463e7564, type: 3}
  - speakerName: LUMI
    dialogue: Antes de ser chamado de Vazio, ele foi um mago da Ordem Arcana... um
      dos nossos.
    illustration: {fileID: 21300000, guid: c8cc1f37db565704da4733dc5069eea2, type: 3}
  - speakerName: LYREN
    dialogue: "Ent\xE3o ele conhece os segredos da Ordem. Mas o que fez um de seus
      magos se voltar contra tudo o que jurou proteger?"
    illustration: {fileID: 21300000, guid: ced044de4e4910a428a9f9e96982b718, type: 3}
