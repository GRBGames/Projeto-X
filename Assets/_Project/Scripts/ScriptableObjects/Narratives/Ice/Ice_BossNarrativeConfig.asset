  region: 1
  rewardMessage: FAGULHA DE GELO RECEBIDA
  rewardIllustration: {fileID: 21300000, guid: 27f8cc56214b9af40be2cc7745162564, type: 3}
  memoryPages:
  - speakerName: LUMI
    dialogue: "A Fagulha de Gelo tamb\xE9m guarda uma lembran\xE7a, Lyren. Vamos
      ver o que ela quer mostrar."
    illustration: {fileID: 21300000, guid: 29e679391d847244fa1cd3e96b522eb9, type: 3}
  - speakerName: LUMI
    dialogue: "Ele queria que um \xFAnico mago controlasse os quatro elementos. A
      Ordem achou isso perigoso e disse n\xE3o."
    illustration: {fileID: 21300000, guid: fc1d9ff18db1778449189eb87ea2d22b, type: 3}
  - speakerName: LYREN
    dialogue: "Ent\xE3o foi a\xED que ele come\xE7ou a se afastar da Ordem... Mas
      s\xF3 uma resposta negativa n\xE3o explica tudo."
    illustration: {fileID: 21300000, guid: 4ef7eb8658d1e0949913041306a8c8f5, type: 3}
  destinationSceneName: WorldMap
  destinationButtonText: VOLTAR AO MAPA
