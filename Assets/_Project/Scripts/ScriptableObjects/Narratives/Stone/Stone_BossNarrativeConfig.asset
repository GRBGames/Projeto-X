  region: 3
  rewardMessage: FAGULHA DE PEDRA RECEBIDA
  rewardIllustration: {fileID: 21300000, guid: 4586a77b50eb44e438126201ac2934e5, type: 3}
  memoryPages:
  - speakerName: LUMI
    dialogue: "A Fagulha de Pedra mostra a parte final da lembran\xE7a, Lyren. O
      Vazio j\xE1 est\xE1 se preparando para usar os quatro cristais."
    illustration: {fileID: 21300000, guid: 63c38ecf6b7de3c4bb2fcb54dce9d81c, type: 3}
  - speakerName: LUMI
    dialogue: "Ele quer criar o Eclipse Elemental. Se conseguir, Fogo, Gelo, Planta
      e Pedra v\xE3o perder o equil\xEDbrio."
    illustration: {fileID: 21300000, guid: 9e7b2b6e88fcf4449a4b94e68ff9bc9c, type: 3}
  - speakerName: LYREN
    dialogue: "Ent\xE3o preciso chegar ao castelo antes que o eclipse comece. Se
      eu falhar, todo o reino estar\xE1 em perigo."
    illustration: {fileID: 21300000, guid: 2c62b19501b9b3f4e9b763fc2df4a6a6, type: 3}
  destinationSceneName: WorldMap
  destinationButtonText: VOLTAR AO MAPA
